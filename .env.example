# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
POSTGRES_USER=fitnesstracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fitnesstracker
# Used by the backend; host "postgres" refers to the docker-compose service name.
DATABASE_URL=postgresql://fitnesstracker:change-me@postgres:5432/fitnesstracker

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Required to register the first (and only) account. Pick your own long random value.
SETUP_TOKEN=change-me-setup-token
# Optional: login/registration attempts per minute and IP (default 5). Leave unset in production.
# AUTH_RATE_LIMIT_PER_MINUTE=5
# Optional: requests per minute and IP on the expensive routes (AI calls, photo/video upload,
# data export; default 10).
# HEAVY_RATE_LIMIT_PER_MINUTE=10
# In production the backend refuses to start while one of the three values above still contains a
# placeholder like "change-me". Generate real ones, e.g. `openssl rand -base64 32`.

# --- Networking ---
NODE_ENV=development
PORT=3000
# Proxies in front of the backend whose X-Forwarded-For may be believed (empty = none, right for
# local development). docker-compose.prod.yml sets it for the Cloudflare tunnel + Caddy chain.
# Accepts true, a hop count, or a comma-separated list of IPs/CIDRs/loopback/linklocal/uniquelocal.
# TRUST_PROXY=
# Origin allowed to call the API with credentials (dev only; prod is same-origin via Caddy)
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Where progress-photo uploads are stored on disk (relative to the backend package's cwd).
# Optional — defaults to ./uploads.
UPLOADS_DIR=./uploads

# --- Web Push (optional — subscribe/send both no-op until all three are set) ---
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required by the Web Push protocol as a way to contact you if a push provider needs to reach
# the sender; mailto: or an https:// URL.
VAPID_SUBJECT=mailto:you@example.com

# --- AI-Trainingsplan-Generator / BYOK (optional — /ai-settings responds "not configured"
# until this is set; existing installs without it are unaffected) ---
# Master key for encrypting user-supplied AI provider API keys at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SETTINGS_ENCRYPTION_KEY=

# --- Prod only (Caddy) ---
DOMAIN=fitness.example.com
