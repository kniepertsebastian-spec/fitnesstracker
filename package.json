{
  "name": "fitnesstracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:shared": "pnpm --filter @fitnesstracker/shared build",
    "dev:backend": "pnpm run build:shared && pnpm --filter backend dev",
    "dev:frontend": "pnpm run build:shared && pnpm --filter frontend dev",
    "build": "pnpm run build:shared && pnpm --filter backend build && pnpm --filter frontend build",
    "prisma:migrate": "pnpm --filter backend prisma:migrate",
    "prisma:generate": "pnpm --filter backend prisma:generate",
    "prisma:seed": "pnpm --filter backend prisma:seed",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.68.0"
  }
}
