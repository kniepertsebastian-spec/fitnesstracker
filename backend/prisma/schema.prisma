datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TrainingPhase {
  AUFBAU
  MUSKELAUSDAUER
  NEGATIV
}

enum GoalType {
  WEIGHT
  REPS
  BODYWEIGHT
  CUSTOM
}

enum Gender {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum NutritionGoal {
  CUT
  MAINTAIN
  BULK
}

// Roadmap Phase 19: BYOK AI training plan generator. All four are called through the same
// OpenAI-compatible chat-completions shape — see aiPlanGenerator/aiClient.ts.
enum AiProvider {
  GEMINI
  OPENAI
  GROQ
  OPENROUTER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  // Overrides the weight-derived water target (35ml/kg) from Phase 9. Lives on `User`, not
  // `Profile`, so a custom water target can be set without first filling in a full nutrition
  // profile (weight/height/age/gender) — see ROADMAP.md Phase 18 / ARCHITECTURE.md.
  waterTargetMlOverride Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens          RefreshToken[]
  workoutLogs            WorkoutLog[]
  trainingPlan           TrainingPlan?
  goals                  Goal[]
  pushSubscriptions      PushSubscription[]
  profile                Profile?
  waterLogs              WaterLog[]
  dailyChallengeItems    DailyChallengeItem[]
  supplements            Supplement[]
  bodyCompositionEntries BodyCompositionEntry[]
  progressPhotos         ProgressPhoto[]
  planExercises          PlanExercise[]
  aiProviderSetting      AiProviderSetting?
}

// One active BYOK provider config per user — "flexible Auswahl und Hinterlegung eines API-Keys"
// means switching providers by re-saving this row, not managing several keys at once.
model AiProviderSetting {
  id              String     @id @default(uuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        AiProvider
  // AES-256-GCM ciphertext ("iv:authTag:ciphertext", all hex) — see lib/crypto.ts. Never
  // decrypted for a response body, only used server-side to call the provider.
  encryptedApiKey String
  // Optional override of the provider's default model (see aiClient.ts's PROVIDER_CONFIG).
  model           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Exercise {
  id          String   @id @default(uuid())
  name        String
  // German display name, shown in the UI instead of `name` when present. Kept separate from
  // `name` (not overwritten in place) because re-importing a source overwrites `name` from the
  // upstream English dataset on every run — see exercise.service.ts's importExercisesFromSource.
  nameDe      String?
  // Execution technique description. For imported exercises this is the source's
  // instructions joined into one text; edit freely afterwards.
  description String?
  // No free/open source used so far ships actual video — left for manual curation or a
  // future source adapter that provides one.
  videoUrl    String?
  imageUrls   String[] @default([])
  equipment   String?
  category    String?
  primaryMuscles   String[] @default([])
  secondaryMuscles String[] @default([])
  // Provenance for idempotent re-imports, e.g. source="free-exercise-db", sourceId="3_4_Sit-Up".
  // Manually created exercises leave both null; Postgres allows unlimited NULL/NULL pairs
  // under a unique index, so this doesn't collide with imported rows.
  source      String?
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workoutLogs         WorkoutLog[]
  goals               Goal[]
  dailyChallengeItems DailyChallengeItem[]
  planExercises       PlanExercise[]

  @@unique([source, sourceId])
  @@index([name])
}

model WorkoutLog {
  id          String    @id @default(uuid())
  // Client-generated UUID, used as an idempotency key for the future offline-sync queue.
  clientId    String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])
  setNumber   Int
  reps        Int
  weightKg    Decimal   @db.Decimal(6, 2)
  // Reps In Reserve at the end of the set (0 = to failure). Optional — most historical rows and
  // casual logging won't set it; only used to compute a more informed 1RM estimate client-side.
  rir         Int?
  performedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Soft delete so offline clients can sync tombstones instead of losing deletes.
  deletedAt   DateTime?
  // Client-generated UUID shared by sets logged as one superset/drop-set round — same
  // client-owns-the-id pattern as `clientId`, since grouping is decided at log time on the
  // client, not inferred after the fact from timestamps.
  supersetGroupId String?

  @@index([userId, performedAt])
  @@index([userId, supersetGroupId])
}

// Roadmap: 8-week auto-rotating training focus (Aufbau -> Muskelausdauer -> Negativ -> Aufbau).
model TrainingPlan {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentPhase   TrainingPhase @default(AUFBAU)
  // Always a Monday; the scheduler advances the phase 8 weeks after this date.
  phaseStartedOn DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  phaseHistory TrainingPlanPhaseHistory[]
}

model TrainingPlanPhaseHistory {
  id             String        @id @default(uuid())
  trainingPlanId String
  trainingPlan   TrainingPlan  @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  phase          TrainingPhase
  startedOn      DateTime
  endedOn        DateTime?

  // Guards against duplicate rows if a scheduler tick and a request both rotate the same
  // overdue period concurrently (see trainingPlan.service.ts) — each period is closed once.
  @@unique([trainingPlanId, startedOn])
  @@index([trainingPlanId])
}

// An exercise assigned to a training phase (Aufbau/Muskelausdauer/Negativ) — keyed by phase, not
// by a specific TrainingPlan rotation instance, since the same phase recurs every 8-week cycle
// and the assigned exercises should still be there next time it comes around.
model PlanExercise {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  phase      TrainingPhase
  exerciseId String
  exercise   Exercise      @relation(fields: [exerciseId], references: [id])
  targetSets Int?
  targetReps Int?
  // Manual position within the phase's list; new entries append after the current max. For
  // AI-generated entries this is the position within `dayLabel`, not a global index across the
  // whole phase.
  order      Int           @default(0)
  // Which split day (e.g. "Push (Brust, Schultern, Trizeps)") this entry belongs to — set only
  // by the AI plan generator for a multi-day split. Null for manually added entries and for a
  // single-day ("Ganzkörper") plan, which has nothing to group by.
  dayLabel   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, phase, exerciseId, dayLabel])
  @@index([userId, phase, order])
}

// Roadmap: goal setting.
model Goal {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String?
  exercise    Exercise? @relation(fields: [exerciseId], references: [id])
  type        GoalType
  targetValue Decimal   @db.Decimal(6, 2)
  targetDate  DateTime?
  achievedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Roadmap: Web Push subscriptions for the 8-week plan-change reminder.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Inputs for the calorie/protein calculator (Mifflin-St Jeor). One profile per user, always
// fully replaced on edit rather than partially patched — the fields are meaningless in
// isolation from each other, so there's no "just update the goal" use case worth supporting.
model Profile {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg      Decimal       @db.Decimal(5, 2)
  heightCm      Int
  age           Int
  gender        Gender
  activityLevel ActivityLevel @default(MODERATE)
  goal          NutritionGoal @default(MAINTAIN)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// One row per user per calendar day (UTC) — a running total, not an event log, since nothing in
// the roadmap needs per-glass timing, only "how much today" and a short daily history.
model WaterLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  amountMl Int      @default(0)

  @@unique([userId, date])
}

// A day's "do it anywhere, no equipment" mini-workout: a handful of exercises picked at random
// from the imported catalog (equipment = "body only") the first time the user opens it that
// day, each with a random rep target. Re-opening the same day returns the same set — the
// randomness happens once per day, not on every read.
model DailyChallengeItem {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  exerciseId    String
  exercise      Exercise @relation(fields: [exerciseId], references: [id])
  targetReps    Int
  completedReps Int      @default(0)

  @@unique([userId, date, exerciseId])
}

// A daily push reminder for one supplement. `reminderTime` ("HH:MM") is local wall-clock time
// in `timeZone` (an IANA name captured from the browser at creation), not UTC — a reminder
// firing at the wrong hour would defeat the entire point of the feature, unlike the day-boundary
// fuzziness elsewhere in this app (water reset, plan rotation) where nobody notices a few hours
// of slop. `lastRemindedOn` ("YYYY-MM-DD" in that same local time) stops the scheduler from
// sending twice on the same local day.
model Supplement {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  reminderTime   String
  timeZone       String
  enabled        Boolean  @default(true)
  lastRemindedOn String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One row per manual scale reading. No upsert-by-day like WaterLog — a body-comp reading is a
// point-in-time log entry a user might take more than once a day or skip for weeks, not a daily
// running total. Only weightKg is required; smart scales vary widely in which of the rest they
// report at all.
model BodyCompositionEntry {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt       DateTime @default(now())
  weightKg         Decimal  @db.Decimal(5, 2)
  bodyFatPercent   Decimal? @db.Decimal(4, 1)
  muscleMassKg     Decimal? @db.Decimal(5, 2)
  bodyWaterPercent Decimal? @db.Decimal(4, 1)
  createdAt        DateTime @default(now())

  @@index([userId, measuredAt])
}

// A private "mirror photo" for visual before/after comparison. The file itself lives on disk
// under UPLOADS_DIR (own VPS filesystem, no cloud storage per ARCHITECTURE.md) — this row is
// just the metadata plus the generated filename used to locate it. Never exposed directly —
// always served through the authenticated /progress-photos/:id/file route since these are
// private body photos, not public assets.
model ProgressPhoto {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  takenAt   DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, takenAt])
}
