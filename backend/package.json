{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:translate-names": "tsx prisma/translateExerciseNames.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fitnesstracker/shared": "workspace:*",
    "@google/genai": "^2.23.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.0.1",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "tsx": "^4.19.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.7.4",
    "@types/pdfkit": "^0.17.7",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^11.2.2",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
